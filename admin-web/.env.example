# Admin login password. REQUIRED in production.
# Minimum 8 characters. The admin will refuse all logins if this is unset
# or too short on a production deployment.
ADMIN_PASSWORD=please-set-a-real-password-of-8-or-more-chars

# Supabase (set all three in Vercel; the URL + ANON keys are public,
# the SERVICE_ROLE key must NEVER be exposed to the client).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-jwt-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-here

# OpenAI (Phase 4b). Required for /api/ai/meal-plan to work.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# Hard daily ceiling on total cost in USD across all users. The endpoint
# refuses new generations once this is exceeded today. Defaults to 5.
OPENAI_DAILY_BUDGET_USD=5
# Models. gpt-4o-mini for text, gpt-image-1 for images. Override if needed.
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
