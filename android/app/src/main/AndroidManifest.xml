<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Google Play Billing for Silver/Gold subscriptions. -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Required on Android 13 (API 33) and up to display notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitMealAI">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FitMealAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM listener. Real delivery requires a google-services.json
             in app/. Without it, this service still registers but is
             never invoked because Firebase fails to initialize. -->
        <service
            android:name=".push.FitMealMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default notification channel for FCM data messages. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="fitmeal_default" />
    </application>
</manifest>
